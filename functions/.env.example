# Cloud Functions runtime config. Copy to functions/.env and fill in.
# Nothing here is a secret — SMTP credentials live in the Trigger Email
# extension's own config, not in this repo.

# Where new-member notifications are sent. Defaults to the network's address.
RELIF_NOTIFY_TO=redinnovacionfrugal@gmail.com

# Deep link included in the email so a reviewer can open the queue directly.
RELIF_ADMIN_URL=https://redinnovacionfrugal.lat/admin
