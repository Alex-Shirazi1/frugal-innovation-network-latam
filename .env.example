# ---- Backend (server/) ----
# Port for the prototype API (default 3001)
PORT=3001
# Secret for the /admin approval queue. REQUIRED in production.
ADMIN_KEY=change-me
# SQLite file location (default server/relif.db)
RELIF_DB_PATH=server/relif.db

# ---- Frontend: which backend to talk to ----
# 'firestore' = hosted production backend (needs the Firebase block below)
# 'http'      = local Express dev API at VITE_API_BASE_URL
# 'bundled'   = compiled-in data only, no backend at all
# Leave unset to auto-detect: Firebase configured -> firestore, else http.
VITE_DATA_SOURCE=http

# ---- Firebase (production backend) ----
# Publishable client identifiers, NOT secrets — firestore.rules is the security
# boundary. Copy these from Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional — derived from the project id when omitted.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ---- Frontend (Vite) ----
# Where the http adapter points. Default '/api' (dev proxy → localhost:3001).
# Swap the backend by changing this URL — no code changes needed.
VITE_API_BASE_URL=/api

# ---- New-member email notification ----
# Web3Forms access key. The site emails redinnovacionfrugal@gmail.com with the
# subject "Solicitud de nueva membresía" when someone completes the join form.
# Public by design — the destination is bound to the key on Web3Forms' side, so
# it cannot relay mail elsewhere. Unset means no notification is sent and no
# request is made; submissions are still stored and still visible at /admin.
VITE_WEB3FORMS_KEY=

# ---- Analytics ----
# PostHog analytics — copy to `.env.local` and fill in your project values.
# Analytics stays disabled (no network calls) until VITE_POSTHOG_KEY is set.

# Project API key from PostHog → Settings → Project (starts with phc_)
VITE_POSTHOG_KEY=

# Ingestion host. US cloud is the default; use https://eu.i.posthog.com for EU,
# or your self-hosted URL. Leave unset to use the US default.
VITE_POSTHOG_HOST=https://us.i.posthog.com
