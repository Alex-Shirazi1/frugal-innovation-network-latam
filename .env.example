# ---- Backend (server/) ----
# Port for the prototype API (default 3001)
PORT=3001
# Secret for the /admin approval queue. REQUIRED in production.
ADMIN_KEY=change-me
# SQLite file location (default server/relif.db)
RELIF_DB_PATH=server/relif.db

# ---- Frontend: which backend to talk to ----
# 'firestore' = hosted production backend (needs the Firebase block below)
# 'http'      = local Express dev API at VITE_API_BASE_URL
# 'bundled'   = compiled-in data only, no backend at all
# Leave unset to auto-detect: Firebase configured -> firestore, else http.
VITE_DATA_SOURCE=http

# ---- Firebase (production backend) ----
# Publishable client identifiers, NOT secrets — firestore.rules is the security
# boundary. Copy these from Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional — derived from the project id when omitted.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ---- Local admin panel against the Firebase emulator ----
# 'true' points the SDK at the emulator suite (firestore :8080, auth :9099)
# instead of the real project, so /admin can be worked on without touching live
# data. Dev-only: the branch is also gated on import.meta.env.DEV, so setting
# this in a deploy environment does nothing. See README, "Admin access".
#
#   npm run emulators / npm run seed:emulator / npm run dev
#
# There is no admin password here, and there never should be: Firebase Auth
# holds the hash and checks it. The emulator's dev account is created by
# server/scripts/seed-emulator.ts.
VITE_FIREBASE_EMULATOR=

# ---- Frontend (Vite) ----
# Where the http adapter points. Default '/api' (dev proxy → localhost:3001).
# Swap the backend by changing this URL — no code changes needed.
VITE_API_BASE_URL=/api

# ---- New-member email notification ----
# Where "Solicitud de nueva membresía" is delivered when someone completes the
# join form, via FormSubmit (formsubmit.co). No account needed.
#
# Use the OPAQUE ALIAS, not an address. Vite bakes this value into the bundle,
# so a plain address is readable by anyone viewing source on the live site; the
# alias resolves to the inbox on FormSubmit's side and reveals nothing.
#
# To point this at a new inbox, see "Changing the destination" in the README.
# Set it in .env.local for development and as the VITE_NOTIFY_TARGET Actions
# secret for deploys. Unset means no notification is sent and no request is
# made; submissions are still stored and still visible at /admin.
VITE_NOTIFY_TARGET=

# ---- Analytics ----
# PostHog analytics — copy to `.env.local` and fill in your project values.
# Analytics stays disabled (no network calls) until VITE_POSTHOG_KEY is set.

# Project API key from PostHog → Settings → Project (starts with phc_)
VITE_POSTHOG_KEY=

# Ingestion host. US cloud is the default; use https://eu.i.posthog.com for EU,
# or your self-hosted URL. Leave unset to use the US default.
VITE_POSTHOG_HOST=https://us.i.posthog.com
