# ---- Backend (server/) ----
# Port for the prototype API (default 3001)
PORT=3001
# Secret for the /admin approval queue. REQUIRED in production.
ADMIN_KEY=change-me
# SQLite file location (default server/relif.db)
RELIF_DB_PATH=server/relif.db

# ---- Frontend (Vite) ----
# Where the http adapter points. Default '/api' (dev proxy → localhost:3001).
# Swap the backend by changing this URL — no code changes needed.
VITE_API_BASE_URL=/api
# 'http' (default, falls back to bundled data if unreachable) or 'bundled'
# for a fully static build with no backend at all.
VITE_DATA_SOURCE=http

# ---- Analytics ----
# PostHog analytics — copy to `.env.local` and fill in your project values.
# Analytics stays disabled (no network calls) until VITE_POSTHOG_KEY is set.

# Project API key from PostHog → Settings → Project (starts with phc_)
VITE_POSTHOG_KEY=

# Ingestion host. US cloud is the default; use https://eu.i.posthog.com for EU,
# or your self-hosted URL. Leave unset to use the US default.
VITE_POSTHOG_HOST=https://us.i.posthog.com
