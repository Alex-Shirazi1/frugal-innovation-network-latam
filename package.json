{
  "name": "frugal-innovation-network-la",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/index.ts",
    "dev:all": "concurrently -n web,api -c cyan,green \"npm:dev\" \"npm:dev:server\"",
    "seed": "tsx server/scripts/seed.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "rules": "tsx server/scripts/generate-firestore-rules.ts",
    "test:rules": "firebase emulators:exec --only firestore,auth --project relif-rules-test \"vitest run server/firestore-rules.test.ts server/firestore-adapter.test.ts\"",
    "grant-admin": "tsx server/scripts/grant-admin.ts",
    "relock": "./scripts/relock.sh"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "cors": "^2.8.6",
    "d3-geo": "^3.1.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase": "^12.16.0",
    "posthog-js": "^1.407.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.24.0",
    "jsdom": "^24.1.3",
    "oxlint": "^1.71.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3"
  }
}
